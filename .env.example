# 개발 서버 프록시가 /api 요청을 보낼 Gateway 주소입니다. 비우면 http://127.0.0.1:8080
API_PROXY_TARGET=http://127.0.0.1:8080

# 'true'면 배포 빌드에서도 충전 화면에 Mock Bank 테스트 계좌 버튼을 보여 줍니다(시연용). 개발 서버는 항상 보입니다.
# VITE_SHOW_TEST_ACCOUNTS=true

# 로컬 Mock Bank DB에만 직접 넣은 계좌를 충전 화면 테스트 계좌 버튼에 '로컬 전용'으로 붙입니다.
# 형식: 은행코드:계좌번호:예금주. 예금주는 가입 실명과 정확히 같아야 합니다. 실명이 들어가므로 .env.local에만 둡니다.
# VITE_LOCAL_TEST_ACCOUNT=004:77770000000001:홍길동
